# Project-local harness data (agent plans under .minimal/plans/, web_fetch
# spill cache under .minimal/web-fetch/). In-repo only because tools reach it
# through project-root confinement; never committed.
.minimal/
src-*.md
.opencode/
.claude/
# Build output
build/
build-debug/
build-server/
build-asan/
build-tsan/
build-clang/
build-gcc/
out/
cmake-build-*/
install/

# Stray CMake configure output (cmake run in the repo root instead of build/)
/CMakeCache.txt
/CMakeFiles/
/CMakeUserPresets.json
/SeedConfig.cmake
/Testing/

# vcpkg manifest-mode install tree
vcpkg_installed/

# vcpkg checkout auto-bootstrapped by ./configure
/.vcpkg/

# Local Linux build/test harness (Docker): Dockerfile + wrapper scripts, and
# its stray artifacts. One-command run: ./docker-linux/build.sh
/docker-linux/
/minimal-linux-build.log

# User plugin registrations (see PLUGINS.md "User plugins"): symlinks into
# your own plugin repos, clones, or scaffolded experiments. Machine-local
# wiring, never harness content.
/user-plugins/

# Generated protobuf/gRPC sources
*.pb.cc
*.pb.h
*.grpc.pb.cc
*.grpc.pb.h

# Tooling
compile_commands.json
.cache/
.ccls-cache/
*.dSYM/

# Editors
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Local runtime artifacts (should live under the platform data dir, but just in case)
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.log

# Python bytecode (scripts/)
__pycache__/
*.pyc
