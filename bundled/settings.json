{
  "default_agent_preset": "build",
  "max_concurrent_subagents": 4,

  "background_wake": false,
  "pause_auto_resume_on_submit": true,

  "memory": {
    "auto_compact": true,
    "context_compaction_trigger": { "percent": 80 },
    "compaction_replace_percent": 80,
    "compaction_strategy": "structured",
    "scrollback_page_size": 100
  },

  "tools": {},

  "tools_view": {
    "stdout_buffer_lines": 100
  },

  "logging": {
    "level": "info",
    "max_size_mb": 10,
    "max_files": 5
  }
}
