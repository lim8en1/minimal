@@ -90,8 +90,15 @@ bool stdio_client::ping() {
     request req = request::create("ping", {});
     
     try {
+        // (minimal-mcp patch) Presence of a RESULT is the liveness signal.
+        // The spec's ping answers with an empty object, so the original
+        // `return result.empty()` worked for conforming servers -- but a
+        // healthy server that echoes richer state was declared dead. Only a
+        // thrown mcp_exception (JSON-RPC error, dead pipe) reports
+        // unhealthy, as the catch below does.
         json result = send_jsonrpc(req);
-        return result.empty();
+        (void)result;
+        return true;
     } catch (...) {
         return false;
     }
@@ -555,13 +562,22 @@ void stdio_client::stop_server_process() {
     // with the fd still valid; the fd is closed only after the join.
     // Terminate process
     if (process_id_ > 0) {
-        LOG_INFO("Sending SIGTERM to process: ", process_id_);
-        kill(process_id_, SIGTERM);
-        
-        // Wait for process to finish
-        int status;
+        // (minimal-mcp patch) Probe before signalling: an already-exited AND
+        // reaped child answers waitpid with ECHILD, and its pid may by then
+        // have been recycled -- kill() would signal an innocent process. Only
+        // a WNOHANG result of 0 ("still running") earns the SIGTERM ladder;
+        // result > 0 means this call reaped the exit, -1 means it is gone.
+        int status = 0;
         pid_t result = waitpid(process_id_, &status, WNOHANG);
         
+        if (result == -1) {
+            LOG_WARNING("Child process ", process_id_, " is no longer ours; skipping termination");
+            result = 1;  // treat as exited: the kill ladder below is skipped
+        } else if (result == 0) {
+            LOG_INFO("Sending SIGTERM to process: ", process_id_);
+            kill(process_id_, SIGTERM);
+        }
+        
         if (result == 0) {
             // Process is still running, wait for a while
             std::this_thread::sleep_for(std::chrono::seconds(2));
