diff --git a/src/mcp_stdio_client.cpp b/src/mcp_stdio_client.cpp
index 1bb596d..676a97f 100644
--- a/src/mcp_stdio_client.cpp
+++ b/src/mcp_stdio_client.cpp
@@ -775,6 +775,26 @@ void stdio_client::read_thread_func() {
             }
         }
     }
+
+    // (minimal-mcp patch) The pipe is closed: no response will ever arrive.
+    // Fail every pending request so its waiter unblocks now instead of
+    // burning the full request timeout -- without this, a child that dies
+    // mid-request wedges the caller's worker thread until the 60 s future
+    // timeout, long after every caller-side deadline has passed and long
+    // after the harness has detached the thread. Same error shape the
+    // response path builds for a JSON-RPC error, so send_jsonrpc throws
+    // mcp_exception as it does for any server-reported error.
+    {
+        std::lock_guard<std::mutex> lock(response_mutex_);
+        for (auto& entry : pending_requests_) {
+            json error_result = {
+                {"isError", true},
+                {"error", {{"code", -1}, {"message", "server closed the connection"}}}
+            };
+            entry.second.set_value(error_result);
+        }
+        pending_requests_.clear();
+    }
 #endif
     
     LOG_INFO("Read thread stopped");
