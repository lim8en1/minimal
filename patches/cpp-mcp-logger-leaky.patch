From: minimal (track R, TSan gate)
Subject: [PATCH] logger: leaky singleton, safe to log during static destruction

minimal-mcp patch: see the comment in the diff.
--- a/include/mcp_logger.h
+++ b/include/mcp_logger.h
@@ -25,8 +25,14 @@
 class logger {
 public:
     static logger& instance() {
-        static logger instance;
-        return instance;
+        // minimal-mcp patch: LEAKY singleton. A detached stdio worker can log
+        // during process static destruction, after a Meyers-singleton's
+        // mutex_ is destroyed -- locking it throws EINVAL and aborts the
+        // process (observed under TSan at high parallelism, in the teardown
+        // of a wedged-detach connection). A leaked logger is never destroyed
+        // and always safe to lock.
+        static logger* instance = new logger();
+        return *instance;
     }
     
     void set_level(log_level level) {
