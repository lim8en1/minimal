From: minimal (track R, TSan gate)
Subject: [PATCH] stdio_client: stop_server_process terminates before closing pipes

minimal-mcp patch: the POSIX stop path closed stdout_pipe_[0] (and wrote -1
to it) BEFORE joining the read thread -- while read_thread_func was still
inside read(stdout_pipe_[0], ...) and looping on it. That is a data race on
the fd member (TSan-reported against the pinned SHA) and can hand close()
an fd the read loop is concurrently using. Order is now: close stdin, THEN
terminate the child (whose death EOFs the pipe and unblocks the read loop),
join the read thread, and only then close stdout_pipe_[0] and write -1 --
so no close/write overlaps a live read of the member.
--- a/src/mcp_stdio_client.cpp
+++ b/src/mcp_stdio_client.cpp
@@ -534,22 +534,11 @@
     }
 #else
     // POSIX implementation
-    // Close pipes
-    if (stdin_pipe_[1] != -1) {
-        close(stdin_pipe_[1]);
-        stdin_pipe_[1] = -1;
-    }
-    
-    if (stdout_pipe_[0] != -1) {
-        close(stdout_pipe_[0]);
-        stdout_pipe_[0] = -1;
-    }
-    
-    // Wait for read thread to finish
-    if (read_thread_ && read_thread_->joinable()) {
-        read_thread_->join();
-    }
-    
+    // minimal-mcp patch: terminate BEFORE closing stdout. The read thread
+    // reads stdout_pipe_[0]; closing (and writing -1 to) it while that loop
+    // is live is a data race, and joining first would hang on a silent
+    // child. Killing the child EOFs the pipe, which unblocks the read loop
+    // with the fd still valid; the fd is closed only after the join.
     // Terminate process
     if (process_id_ > 0) {
         LOG_INFO("Sending SIGTERM to process: ", process_id_);
@@ -574,6 +563,22 @@
         }
         
         process_id_ = -1;
+    }
+    
+    // Close pipes
+    if (stdin_pipe_[1] != -1) {
+        close(stdin_pipe_[1]);
+        stdin_pipe_[1] = -1;
+    }
+    
+    // Wait for read thread to finish
+    if (read_thread_ && read_thread_->joinable()) {
+        read_thread_->join();
+    }
+    
+    if (stdout_pipe_[0] != -1) {
+        close(stdout_pipe_[0]);
+        stdout_pipe_[0] = -1;
     }
 #endif
     
