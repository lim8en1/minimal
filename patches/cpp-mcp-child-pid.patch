+    /**
+     * @brief The spawned server child's process id (minimal-mcp patch).
+     *
+     * The caller owns killing the child on teardown: a wedged blocking call
+     * can outlive every caller-side deadline, and only the pid gives the
+     * caller a handle on the subprocess. Atomic so a teardown racing an
+     * in-flight initialize() still reads the pid the moment fork() records
+     * it. Returns -1 before start_server_process().
+     */
+    int child_pid() const { return process_id_.load(std::memory_order_acquire); }
+
 private:
     // Start server process
     bool start_server_process();
