 void App::Internal::RunOnceBlocking(Component component) {
+#if !defined(_WIN32)
+  // minimal-ftxui-event-loop patch: BLOCK instead of poll-and-sleep. The
+  // upstream loop wakes at ~60 Hz no matter what -- the unconditional 15 ms
+  // animation self-repost keeps the task queue perpetually non-empty -- and
+  // that wake cycle costs a measurable constant CPU floor on an otherwise
+  // idle app (measured ~1.5% of one core whenever a session exists). Here:
+  //   - poll() on the terminal fd plus the wakeup pipe, with the timeout set
+  //     to the earliest due task, so nothing wakes until input arrives, a
+  //     task is posted (App::Post writes the pipe), or a delayed task is due;
+  //   - the 15 ms animation repost is gated (PostAnimationTask), so an app
+  //     that never requests animation has NO scheduled tasks at idle;
+  //   - a partial escape sequence caps the wait, so multi-key input (alt,
+  //     arrows, bracketed paste) resolves promptly via the parser's Timeout;
+  //   - EOF on the terminal fd caps the wait -- poll would otherwise return
+  //     immediately forever and spin.
+  // Upstream's contract ("wait for at least one task to execute") is
+  // preserved: return as soon as RunOnce has executed at least one task.
+  while (!HasQuitted()) {
+    const size_t executed_task = task_runner.ExecutedTasks();
+    auto wait = task_runner.NextWait();
+    int timeout_ms = -1;   // no scheduled task: block until input or Post
+    if (wait.has_value()) {
+      timeout_ms = static_cast<int>(
+          std::chrono::duration_cast<std::chrono::milliseconds>(*wait).count());
+      if (timeout_ms < 0) {
+        timeout_ms = 0;
+      }
+    }
+    if (input_eof_ || terminal_input_parser.has_pending()) {
+      timeout_ms = (timeout_ms < 0 || timeout_ms > 50) ? 50 : timeout_ms;
+    }
+    struct pollfd fds[2] = {
+        {tty_fd_, POLLIN, 0},
+        {wakeup_pipe_[0], POLLIN, 0},
+    };
+    ::poll(fds, 2, timeout_ms);
+    RunOnce(component);
+    if (executed_task != task_runner.ExecutedTasks()) {
+      return;
+    }
+  }
+#else
   // Set FPS to 60 at most.
   const auto time_per_frame = std::chrono::microseconds(16666);  // 1s / 60fps
 
