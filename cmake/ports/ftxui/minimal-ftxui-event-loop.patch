diff --git a/src/ftxui/component/task_queue.cpp b/src/ftxui/component/task_queue.cpp
index a6b75c6..6829805 100644
--- a/src/ftxui/component/task_queue.cpp
+++ b/src/ftxui/component/task_queue.cpp
@@ -64,4 +64,22 @@ auto TaskQueue::HasImmediateTasks() const -> bool {
   return !immediate_tasks_.empty();
 }
 
+// minimal-ftxui-event-loop patch: see task_queue.hpp.
+auto TaskQueue::NextWait() const
+    -> std::optional<std::chrono::steady_clock::duration> {
+  const std::lock_guard<std::mutex> lock(mutex_);
+  if (!immediate_tasks_.empty()) {
+    return std::chrono::steady_clock::duration::zero();
+  }
+  if (!delayed_tasks_.empty()) {
+    const auto& top = delayed_tasks_.top();
+    if (top.time.has_value()) {
+      const auto now = std::chrono::steady_clock::now();
+      return top.time.value() > now ? top.time.value() - now
+                                    : std::chrono::steady_clock::duration::zero();
+    }
+  }
+  return std::nullopt;
+}
+
 }  // namespace ftxui::task
