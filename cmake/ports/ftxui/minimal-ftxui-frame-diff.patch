 namespace ftxui {
 
+// ============================================================================
+// minimal-ftxui patch: frame diffing + single requirement pass.
+//
+// Upstream Draw() repaints the ENTIRE screen on every frame: it walks the
+// whole element tree, composes every cell, serializes every cell to a string,
+// and writes the whole thing. For a full-screen app whose frames usually
+// differ in a handful of rows (a streaming chat, a ticking counter), that is
+// the single largest CPU and terminal-bandwidth cost. Three changes, all
+// switchable off with MINIMAL_FTXUI_DIFF=0 (which restores the upstream
+// behavior exactly):
+//
+//   C. Draw() called document->ComputeRequirement() unconditionally, then
+//      Render() ran its layout loop which calls ComputeRequirement() AGAIN on
+//      the same fresh tree. The requirement is only READ for the
+//      TerminalOutput and FitComponent dimensions; for Fullscreen/Fixed the
+//      explicit pass is dead work -- one whole-tree walk saved per frame.
+//
+//   A. Identical-frame skip: the composed frame is diffed against the
+//      previous one; when equal, nothing is written at all. This kills the
+//      redundant full-screen writes that input events (mouse move!) trigger
+//      without changing any pixel.
+//
+//   B. Dirty-region write: when the frame changed, only the rows that
+//      actually differ are emitted, each positioned absolutely
+//      (CSI row;1H), prefixed with an SGR reset (each Screen::ToString row
+//      is serialized relative to the default style -- see the inter-row
+//      UpdateCellStyle transition there), and the cursor is parked back at
+//      the bottom-right corner the same place a full write leaves it, so
+//      ResetPosition()'s relative walk-up and the caller's cursor handling
+//      stay byte-identical to upstream.
+//
+// The previous-frame snapshot is main-thread-only (Draw runs on the render
+// loop) and is dropped by Install() -- after a suspend/resume the terminal's
+// alternate screen is cleared, so the first frame must be a full write.
+// ============================================================================
+
+namespace {
+bool FrameDiffEnabled() {
+  static const bool enabled = [] {
+    const char* env = std::getenv("MINIMAL_FTXUI_DIFF");
+    return !(env != nullptr && std::string_view(env) == "0");
+  }();
+  return enabled;
+}
+
+// Appends to `out` the escape sequences that turn the terminal from
+// displaying `previous` into displaying `next` (both Screen::ToString frames
+// of `rows` rows, "\r\n"-separated). Rows are compared byte-exactly; a row
+// that differs is rewritten in full.
+void AppendFrameDiff(const std::string& previous,
+                     const std::string& next,
+                     int rows,
+                     int columns,
+                     std::string& out) {
+  std::size_t p_begin = 0;
+  std::size_t n_begin = 0;
+  for (int row = 0; row < rows; ++row) {
+    const std::size_t p_end = previous.find("\r\n", p_begin);
+    const std::size_t n_end = next.find("\r\n", n_begin);
+    const std::string_view p_line =
+        p_end == std::string::npos ? std::string_view(previous).substr(p_begin)
+                                   : std::string_view(previous).substr(p_begin, p_end - p_begin);
+    const std::string_view n_line =
+        n_end == std::string::npos ? std::string_view(next).substr(n_begin)
+                                   : std::string_view(next).substr(n_begin, n_end - n_begin);
+    if (p_line != n_line) {
+      out += "\x1b[0m";  // rows serialize relative to the default style
+      out += "\x1b[" + std::to_string(row + 1) + ";1H";
+      out.append(n_line);
+    }
+    if (p_end == std::string::npos || n_end == std::string::npos) {
+      break;
+    }
+    p_begin = p_end + 2;
+    n_begin = n_end + 2;
+  }
+  // Park the cursor where a full-frame write would have left it
+  // (bottom-right), so the relative cursor handling after the frame
+  // (ResetPosition, set_cursor_position_) stays correct.
+  out += "\x1b[" + std::to_string(rows) + ";" + std::to_string(columns) + "H";
+}
+}  // namespace
